# Server
PORT=5000
NODE_ENV=development
# Public URL of the site (used to build payment links)
PUBLIC_URL=http://localhost:5173

# MongoDB (Atlas URI in production)
MONGODB_URI=mongodb://127.0.0.1:27017/focas_qb

# Admin
ADMIN_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-string

# Razorpay (test keys from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxx
